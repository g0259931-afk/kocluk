{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@saas-coach/types": ["packages/types/index.ts"],
      "@saas-coach/utils": ["packages/utils/index.ts"],
      "@saas-coach/shared": ["packages/shared/index.ts"],
      "@saas-coach/auth": ["packages/auth/index.ts"],
      "@saas-coach/database": ["packages/database/index.ts"],
      "@saas-coach/ai": ["packages/ai/index.ts"],
      "@saas-coach/backend": ["apps/backend/index.ts"],
      "@/web/*": ["apps/web/*"],
      "@/admin/*": ["apps/admin/*"],
      "@/backend/*": ["apps/backend/*"],
      "@/ui/*": ["packages/ui/*"],
      "@/shared/*": ["packages/shared/*"],
      "@/auth/*": ["packages/auth/*"],
      "@/database/*": ["packages/database/*"],
      "@/ai/*": ["packages/ai/*"],
      "@/api/*": ["packages/api/*"],
      "@/config/*": ["packages/config/*"],
      "@/types/*": ["packages/types/*"],
      "@/hooks/*": ["packages/hooks/*"],
      "@/utils/*": ["packages/utils/*"],
      "@/services/*": ["packages/services/*"],
      "@/repositories/*": ["packages/repositories/*"]
    }
  },
  "exclude": ["node_modules"]
}
